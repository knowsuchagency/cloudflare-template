{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{ worker_name }}",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": { "enabled": true },
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{ d1_database_name }}",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create",
      "migrations_dir": "./drizzle"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"{% if cloudflare_account_subdomain %},
    // Workers Builds preview URLs (`<version>-{{ worker_name }}.<sub>.workers.dev`)
    // are siblings of the prod URL under the same account subdomain. Seeding the
    // wildcard here means auth works on previews even before `mise run deploy`
    // patches BETTER_AUTH_URL to the deployed origin (which would let
    // deriveTrustedOrigins() infer the same wildcard automatically).
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://*.{{ cloudflare_account_subdomain }}.workers.dev"{% endif %}
  },
  // The `env.preview` block below defines a STANDALONE preview Worker
  // `{{ worker_name }}-preview` with its own `{{ d1_database_name }}-preview`
  // D1, reachable ONLY via a manual `wrangler deploy --env preview` from a
  // workstation (e.g. `mise run deploy:preview`) — useful for end-to-end
  // testing of breaking schema changes against disposable data.
  //
  // **Workers Builds (push-to-deploy) does NOT use this block.** Workers
  // Builds is connected per-Worker — its triggers can only upload versions
  // to `{{ worker_name }}` (the connected Worker), not to a sibling Worker
  // like `{{ worker_name }}-preview`, regardless of `--env` or `--name`
  // flags. So PR-branch builds get versions of the prod Worker bound to
  // the *top-level* config (DB → `{{ d1_database_name }}`, etc.). Schema
  // and binding changes in PRs MUST be forward-compatible with the live
  // prod resources, or use a two-PR sequence (migration first, feature
  // second) so the prod D1 is upgraded by the first merge before the
  // feature code runs against it. See `mise.toml` → `tasks.builds:connect`
  // for the full rationale.
  //
  // d1_databases / vars are non-inheritable — every binding the standalone
  // preview Worker uses must be redeclared here.
  "env": {
    "preview": {
      "name": "{{ worker_name }}-preview",
      // `routes` IS inheritable. The day someone adds a top-level
      // custom-domain route here, the next `wrangler deploy --env preview`
      // would silently inherit it and reassign the prod hostname to the
      // preview Worker — an outage. Pinning routes=[] makes the preview
      // Worker incapable of owning a custom domain regardless of what
      // top-level config grows.
      "routes": [],
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:8787"{% if cloudflare_account_subdomain %},
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://*.{{ cloudflare_account_subdomain }}.workers.dev"{% endif %}
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{ d1_database_name }}-preview",
          "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create_preview",
          "migrations_dir": "./drizzle"
        }
      ]
    }
  }
}
